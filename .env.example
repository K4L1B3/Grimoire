POSTGRES_PASSWORD=troque-isto
DATABASE_URL=postgres://grimorio:troque-isto@localhost:5432/grimorio
DOMAIN=localhost
PG_PORT=5432

# Sessão: gere com `openssl rand -base64 32`. BETTER_AUTH_URL é o endereço que o navegador usa.
BETTER_AUTH_SECRET=troque-isto-tambem
BETTER_AUTH_URL=http://localhost:3000
# Realtime visto pelo navegador. Em produção (atrás do Caddy) deixe vazio: usa o mesmo domínio.
NEXT_PUBLIC_RT_URL=http://localhost:4000

# Opcional: login com Discord (https://discord.com/developers/applications, redirect {BETTER_AUTH_URL}/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Arquivos no MinIO (S3). Sem S3_ENDPOINT, vão para o disco em UPLOAD_DIR.
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=grimorio
S3_ACCESS_KEY=grimorio
S3_SECRET_KEY=troque-isto-minio
UPLOAD_DIR=./data/uploads
